---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page not found" description="The page you're looking for doesn't exist.">
  <section class="flex min-h-screen items-center justify-center px-6 text-center">
    <div>
      <h1 class="mb-2 text-7xl font-black text-blue-500">404</h1>
      <p class="mb-1 text-xl text-slate-300">Page not found</p>
      <p class="mb-8 text-slate-400">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="inline-block rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-700">Go Home</a>
    </div>
  </section>
</BaseLayout>
